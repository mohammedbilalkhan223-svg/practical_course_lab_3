                <data_type>Expression</data_type>
                <code><![CDATA[# HIL API is imported as 'hil'
# NOTE: Only read functions are available from the HIL API

input_settings = hil.get_scada_input_settings(UI_path + 'P reduction wind speed (SC)')

# specify one bar data ('bar_name', 'value', 'minimum_value' and 'maximum_value' parts are mandatory)
barData1 = {
    # display name
    "bar_name": "Wind speed",
    # value to display
    "value": hil.read_analog_signal(UI_path + 'wind_speed_m_per_s'),
    # value unit
    "unit": "m/s",
    # minimum value
    "minimum_value": 0.0,
    # maximum value
    "maximum_value": 30.0,
    # show warning and critical values
    "use_warning_critical": True,
    # warning value
    "warning_value": hil.read_analog_signal(UI_path + 'nom_wind_speed_m_per_s'),
    # critical value
    "critical_value": input_settings["input_value"],
    }

# list of bars data: [barData1, barData2,...barData10]
displayValue = [barData1]
]]></code>
